{
  "schemaVersion": 1,
  "id": "autism-mace-hitter",
  "version": "${version}",
  "name": "QYS Addon",
  "description": "QYS AUTISM Client addon with situational axe stun slams, spear-reach swaps, and mace attribute swaps.",
  "authors": [
    "quincey-ys"
  ],
  "mixins": [
    "qys-autism-addon.mixins.json"
  ],
  "custom": {
    "autism:color": "220,90,90",
    "modmenu": {
      "parent": {
        "id": "autism"
      }
    }
  },
  "environment": "client",
  "entrypoints": {
    "autism": [
      "com.autismdev.macehitter.QysAutismAddon"
    ]
  },
  "depends": {
    "java": ">=25",
    "minecraft": "${mc_compat}",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "autism": "5.0-26.2"
  }
}
